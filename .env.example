ENVIRONMENT=development

# Database Configuration
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
FHIR_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5435/fhir-server

# Redis Configuration
REDIS_URL=redis://localhost:6380/0

# BetterAuth / IAM — same IdP fhir-gql validates against
IAM_JWKS_URL=http://localhost:5001/api/auth/jwks
IAM_ISSUER=http://localhost:5001

# Local docker instance config (docker-compose.dev.yml)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=fhir-server
POSTGRES_PORT=5435
REDIS_PORT=6380