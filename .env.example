ENVIRONMENT=production

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB below.
# "db" is the Docker service name — do not change the hostname.
FHIR_DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@db/fhir-server

POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=fhir-server

# ── Redis ─────────────────────────────────────────────────────────────────────
# "redis" is the Docker service name — do not change the hostname.
REDIS_URL=redis://redis:6379

# ── BetterAuth / IAM ───────────────────────────────────────────────────────────
# Same IdP the fhir-gql gateway validates against — fhir-server verifies the
# same JWTs directly for its own auth-gated routes (currently: Patient pilot).
IAM_JWKS_URL=http://localhost:5001/api/auth/jwks
IAM_ISSUER=http://localhost:5001

# ── Application behavior ─────────────────────────────────────────────────────
# Rate limiting and which resource routers are mounted are NOT set here —
# they're checked-in application config, not per-environment secrets. See
# configs/config.yaml (and CLAUDE.md's "Environment" section). Anything below
# a nested key there can still be overridden with an env var using "__",
# e.g. RATE_LIMIT__BACKEND=memory or RATE_LIMIT__WRITE_LIMIT=7.
